# Copy this file to .env and replace every value. Never commit .env.

# Superuser used only by the Postgres container itself (admin tasks).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# One least-privilege user per service database (created by infra/postgres/init).
IDENTITY_DB_PASSWORD=change-me
ASSESSMENT_DB_PASSWORD=change-me
EXAM_DB_PASSWORD=change-me
